{
  "name": "path-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "update:schedule": "node scripts/update-schedule.mjs",
    "dev": "pnpm run dev:stack",
    "dev:stack": "vercel dev --listen 8080",
    "test:search": "node scripts/test-search.mjs",
    "test:realtime": "node scripts/test-realtime.mjs",
    "test:departures": "node scripts/test-departures.mjs",
    "test": "node scripts/test-search.mjs && node scripts/test-realtime.mjs && node scripts/test-departures.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vercel": "^59.16.0"
  }
}
